{
  "identifier": "main",
  "description": "Core capabilities for Rocktier Sign",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "fs:default",
    {
      "identifier": "fs:scope",
      "allow": [
        "$APPDATA/certs/**",
        "$APPDATA/**",
        "$DOCUMENT/**",
        "$DOWNLOAD/**",
        "$DESKTOP/**",
        "$HOME/**",
        "$RESOURCE/*"
      ]
    },
    "opener:default"
  ]
}
